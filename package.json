{
  "name": "sanity-image",
  "version": "1.1.0",
  "description": "A well-considered React component for displaying images from Sanity with automatic srcSet generation, hotspot/crop support, and more.",
  "author": "Corey Ward <corey@hey.com>",
  "license": "MIT",
  "repository": "https://github.com/coreyward/sanity-image",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "/dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@sanity-image/url-builder": "workspace:*"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/probe-image-size": "^7.2.5",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^5.0.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.8.1",
    "probe-image-size": "^7.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "size-limit": "^12.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "pnpm build:url-builder && pnpm build:sanity-image",
    "build:sanity-image": "tsdown",
    "build:url-builder": "pnpm --filter @sanity-image/url-builder run build",
    "size": "size-limit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:generate-measurements": "pnpm build && node tests/buildTestCases.mjs",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "pnpm typecheck:url-builder && pnpm typecheck:sanity-image",
    "typecheck:sanity-image": "tsc --noEmit",
    "typecheck:url-builder": "pnpm --filter @sanity-image/url-builder run typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "size-limit": [
    {
      "path": "dist/index.cjs",
      "limit": "4 kB"
    },
    {
      "path": "dist/index.js",
      "limit": "3 kB"
    }
  ],
  "packageManager": "pnpm@12.4.1"
}
